# Public
COMMIT_CHAIN_ID=1952
COMMIT_API_PORT=3080
SEARCHNODE_URL=http://127.0.0.1:3042
NOVA_URL=http://127.0.0.1:3043
COMMIT_API_ORIGIN=http://127.0.0.1:3080

# Local occupancy (PGlite directory). Do not point this at a published evidence database.
COMMIT_PGLITE_DIR=

# Demo-only. Keep 60 in any judge-facing quote that should refuse immediate windows.
COMMIT_MIN_LEAD_SECONDS=60
COMMIT_ALLOW_DEV_SESSION=0
COMMIT_ATTEMPT_TIMEOUT_MS=8000

# Provider admin fault token (local). Never put a real secret in NEXT_PUBLIC_*.
COMMIT_PROVIDER_ADMIN_TOKEN=change-me-local-only

# Optional later: Postgres and chain RPC. Unset means PGlite + pending outbox.
DATABASE_URL=
COMMIT_RPC_URL=
COMMIT_TOKEN=
COMMIT_REGISTRY=
COMMIT_PRIMARY=
COMMIT_BACKUP=
COMMIT_VERIFIER=
COMMIT_WEB_ORIGIN=http://localhost:3000
COMMIT_COOKIE_SECURE=0
COMMIT_BIND=127.0.0.1
COMMIT_XLAYER_WALLETS=
# Local demo only. Signs with the well-known Hardhat mnemonic. Never on a public host.
COMMIT_ALLOW_HARDHAT_KEYS=0

# Testnet 1952 only. Never set this for mainnet 196.
COMMIT_ALLOW_XLAYER=
