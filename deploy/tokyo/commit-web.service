[Unit]
Description=Commit web workbench (loopback :3100)
After=network.target commit-api.service

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/commit/apps/web
EnvironmentFile=/www/wwwroot/commit/.env.staging
ExecStart=/www/wwwroot/commit/apps/web/node_modules/.bin/next start -p 3100 -H 0.0.0.0
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
